# =========================================================
# Root .gitignore for Vercel & Production Deployment
# =========================================================

# Environment variables & API Keys (CRITICAL: Never commit to git)
.env
.env*
!.env.example
backend/.env
frontend/.env*

# Node dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# Vercel Deployment Artifacts
.vercel/
frontend/.vercel/

# TypeScript & Cache
*.tsbuildinfo
.eslintcache

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server.log
server_err.log

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor caches
.vscode/
.idea/
*.swp
*.swo
