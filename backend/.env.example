# =========================================================
# VERCEL ENVIRONMENT VARIABLES TEMPLATE
# Copy and paste these into your Vercel Project Settings:
# Settings -> Environment Variables
# =========================================================

# Database & Security
MONGODB_URI=mongodb+srv://r19216871_db_user:<db_password>@cluster0.cieghmq.mongodb.net/chatly_db?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=your_super_secure_random_jwt_secret_key_change_me
PORT=5000
NODE_ENV=production

# Primary AI: Groq Cloud (Ultra-fast LLMs: groq/compound-mini or llama-3.3-70b)
GROQ_API_KEY=your_groq_api_key_here

# Secondary / Fallback AI: Google Gemini 2.5 Flash
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram TTS (Alexis Voice)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Qdrant Vector Cloud Database
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_URL=https://your-cluster-endpoint.aws.cloud.qdrant.io
QDRANT_COLLECTION=first_cluster

# Mem0 & Neo4j (Optional)
MEM0_API_KEY=your_mem0_key_here
MEM0_COLLECTION=default_project
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
